@page "/"

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-10">
    <MudGrid>
        <MudItem xs="12" md="8">
            <MudText Typo="Typo.h2" Color="Color.Primary" Class="mb-4">
                CBJZ Format
            </MudText>
            <MudText Typo="Typo.h5" Class="mb-6">
                Comic Book JSON Zip
            </MudText>
            <MudText Typo="Typo.body1" Class="mb-8">
                A modern, extensible format for distributing digital comics.
                Combining the high performance of ZIP specifications with the data-rich structure of JSON,
                CBJZ enables deep indexing, native support for coordinate-based character and location tagging,
                and standardized metadata.
            </MudText>

            <MudCard Elevation="3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Schemas documentation</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudText Typo="Typo.body2">
                        Consult the official technical documentation and the class structure of each protocol version
                        to create your own readers or generators.
                    </MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Href="/versions/cbjz-v1.schema.json" Variant="Variant.Filled" Color="Color.Primary"
                               EndIcon="@Icons.Material.Filled.ArrowForward">
                        See Schema v1.0
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Class="pa-4 bg-transparent border-solid border-2 mud-border-primary"
                      Style="border-radius: 16px;">
                <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Link" Class="mr-2" /> Schema URL (SDKs)
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-4" Style="word-break: break-all;">
                    https://ComicBookJson.github.io/scheme/versions/cbj-v1.schema.json
                </MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.ContentCopy">
                    Copiar URL
                </MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>