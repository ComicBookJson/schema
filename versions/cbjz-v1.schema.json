{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ComicBookJson.github.io/schema/versions/cbjz-v1.schema.json",
    "title": "Comic Book JSON Zip (CBJZ) Format",
    "description": "Schema for representing a comic book in a single JSON structure.",
    "type": "object",
    "properties": {
        "version": {
            "type": "string",
            "default": "1.0",
            "description": "The version of the CBJZ protocol."
        },
        "metadata": {
            "$ref": "#/$defs/CbjMetadata"
        },
        "pages": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/CbjPage"
            },
            "minItems": 1,
            "description": "The sequential list of all pages in the comic book."
        }
    },
    "required": [
        "version",
        "metadata",
        "pages"
    ],
    "$defs": {
        "CbjCreator": {
            "type": "object",
            "description": "Represents a creator involved in the comic book (e.g., Writer, Artist).",
            "properties": {
                "name": {
                    "type": "string"
                },
                "role": {
                    "type": "string",
                    "description": "The creator's role, such as 'Writer', 'Penciller', 'Inker', 'Colorist', 'Letterer', 'Cover'."
                }
            },
            "required": [
                "name",
                "role"
            ]
        },
        "CbjTag": {
            "type": "object",
            "description": "Defines a global tag such as a character, location, or event.",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "A unique identifier for this tag within the document (e.g., 'char_batman')."
                },
                "name": {
                    "type": "string",
                    "description": "The display name of the tag (e.g., 'Batman', 'Gotham City')."
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "Character",
                        "Location",
                        "Object",
                        "Event",
                        "Concept",
                        "Other"
                    ],
                    "description": "The category or type of the tag."
                }
            },
            "required": [
                "id",
                "name",
                "type"
            ]
        },
        "CbjChapter": {
            "type": "object",
            "description": "Defines a chapter or story arc for indexing purposes.",
            "properties": {
                "title": {
                    "type": "string",
                    "description": "The title of the chapter."
                },
                "startPageIndex": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "The index of the page where this chapter begins."
                },
                "summary": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "A brief summary of what happens in this chapter."
                }
            },
            "required": [
                "title",
                "startPageIndex"
            ]
        },
        "CbjMetadata": {
            "type": "object",
            "description": "Contains all descriptive information, indexing, and tag definitions.",
            "properties": {
                "title": {
                    "type": "string"
                },
                "series": {
                    "type": "string"
                },
                "issue": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "volume": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "publisher": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "publicationDate": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "date-time"
                },
                "summary": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "language": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "genres": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "creators": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/CbjCreator"
                    }
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/CbjTag"
                    },
                    "description": "A dictionary/list of all tags that appear in the comic."
                },
                "chapters": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/CbjChapter"
                    },
                    "description": "Table of contents or index for easy navigation."
                }
            },
            "required": [
                "title",
                "series"
            ]
        },
        "CbjTagPosition": {
            "type": "object",
            "description": "Represents the spatial position of a tag on a specific page.",
            "properties": {
                "tagId": {
                    "type": "string",
                    "description": "The ID of the tag (referencing metadata.tags)."
                },
                "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "The relative X coordinate of the tag on the page, from 0.0 (left edge) to 1.0 (right edge)."
                },
                "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "The relative Y coordinate of the tag on the page, from 0.0 (top edge) to 1.0 (bottom edge)."
                }
            },
            "required": [
                "tagId",
                "x",
                "y"
            ]
        },
        "CbjPage": {
            "type": "object",
            "description": "Represents a single page containing the image and its specific metadata/tags.",
            "properties": {
                "pageIndex": {
                    "type": "integer",
                    "minimum": 0
                },
                "pageType": {
                    "type": "string",
                    "default": "Story",
                    "description": "Categorizes the page (e.g., 'FrontCover', 'Story', 'Ad', 'Letters', 'BackCover')."
                },
                "summary": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Summary of events happening on this specific page."
                },
                "base64Image": {
                    "type": "string",
                    "description": "The Base64 encoded image string, preferably including the Data URI scheme prefix."
                },
                "pageTags": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/CbjTagPosition"
                    },
                    "description": "A list of tags and their specific coordinates on this page."
                }
            },
            "required": [
                "pageIndex",
                "base64Image"
            ]
        }
    }
}